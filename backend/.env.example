# console.groq.com/keys — create an API key; any listed model id works for GROQ_MODEL.
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# console.agora.io > your project > App ID, and Configure > App Certificate.
AGORA_APP_ID=your_agora_app_id_here
AGORA_APP_CERTIFICATE=your_agora_app_certificate_here
# console.agora.io > Developer Toolkit > RESTful API > Add a secret.
AGORA_CUSTOMER_ID=your_agora_customer_id_here
AGORA_CUSTOMER_SECRET=your_agora_customer_secret_here

# e.g. https://abcd1234.ngrok-free.app for local dev, or your deployed backend URL for production
PUBLIC_BASE_URL=your_public_base_url_here

# Optional path to a Firebase service account key JSON file for local development.
# NEVER commit this file to version control. On Google Cloud, leave this unset to
# use Application Default Credentials via the attached service account/workload identity.
FIREBASE_SERVICE_ACCOUNT_PATH=
